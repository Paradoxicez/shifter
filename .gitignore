# Build artifacts
/bin/
/shifter
# Build artifacts — allow .gitkeep so go:embed all:web/dist compiles before pnpm build runs
/web/dist/*
!/web/dist/.gitkeep
/web/node_modules/
/tmp/
/coverage/
*.test
*.out

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Environment / secrets — D-06 forbids .env for secrets
.env
.env.*
!.env.example
/secrets/*
!/secrets/.gitkeep
!/secrets/README.md

# Air hot reload
/tmp/
