# Shifter — external mode env (OPS-01).
#
# Copy this file to `install/external/.env` and edit. The installer
# (`install/external/install.sh`) sources `.env` before bringing up the
# compose stack, then validates that REQUIRED vars are populated.
#
# This file holds NON-SECRET configuration only. Tokens and passwords
# go into `secrets/*.txt` (file-mounted via Compose `secrets:` per D-06).
# See `secrets/README.md` for the secret-file contract.

# ─────────────────────────────────────────────────────────────────────
# Hostname operators visit. Caddy uses this for ACME or BYO TLS.
# ─────────────────────────────────────────────────────────────────────
SHIFTER_DOMAIN=shifter.example.com

# ─────────────────────────────────────────────────────────────────────
# ChirpStack gRPC endpoint — REQUIRED.
# ─────────────────────────────────────────────────────────────────────
# Format: host:port (no scheme). Examples:
#   chirpstack.acme.local:8080      ← LAN deployment
#   chirpstack.acme.com:443         ← internet-facing with TLS
SHIFTER_CHIRPSTACK_GRPC_URL=chirpstack.example.local:8080

# Use TLS to the gRPC endpoint? Default false; set true when ChirpStack
# is reachable over an untrusted network (internet) and exposes TLS.
SHIFTER_CHIRPSTACK_INSECURE=false

# ─────────────────────────────────────────────────────────────────────
# MQTT broker URL — REQUIRED.
# ─────────────────────────────────────────────────────────────────────
# Format: tcp://host:port  (or ssl://host:port for TLS-secured brokers).
# This must be the SAME broker ChirpStack publishes uplink events to —
# Shifter subscribes to `application/+/device/+/event/up` to ingest
# telemetry. Wrong broker = silent zero-data condition.
SHIFTER_MQTT_URL=tcp://mqtt.example.local:1883

# MQTT username (leave empty for anonymous brokers). Password is a
# secret — populate `secrets/mqtt_password.txt` (chmod 0600), NOT here.
SHIFTER_MQTT_USER=

# ─────────────────────────────────────────────────────────────────────
# TLS mode: acme | byo | internal  (D-21/D-22)
# ─────────────────────────────────────────────────────────────────────
#   acme     — Caddy obtains a Let's Encrypt cert for SHIFTER_DOMAIN
#              (requires SHIFTER_DOMAIN resolvable + ports 80/443 reachable)
#   byo      — operator mounts cert.pem + key.pem into the Caddy container
#              (install.sh expects /etc/caddy/cert.pem + /etc/caddy/key.pem)
#   internal — Caddy issues a self-signed cert; one-time browser warning
#              (lab / pilot / non-public installs)
SHIFTER_TLS_MODE=acme

# ACME contact email (only used when SHIFTER_TLS_MODE=acme).
SHIFTER_TLS_EMAIL=ops@example.com
